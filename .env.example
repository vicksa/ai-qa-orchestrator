# Copy to .env and fill in real values. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

DATABASE_URL=sqlite:///./aiqa.db
# Postgres example (used by docker-compose): postgresql+psycopg2://aiqa:aiqa@postgres:5432/aiqa

REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# Set true to run Playwright in headed mode (useful for local debugging)
BROWSER_HEADLESS=true
